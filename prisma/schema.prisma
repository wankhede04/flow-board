// FlowBoard Prisma schema.
//
// Mirrors the TechSpec §5.2 Postgres DDL. Postgres-only types (tsvector,
// JSONB, BYTEA, TIMESTAMPTZ) are represented with portable equivalents
// (String/Json/Bytes/DateTime), so this schema works unchanged against
// Postgres 13+. Local dev and CI run against a local Postgres instance
// (see docker-compose.yml's `db` service) rather than SQLite, so behavior
// matches production exactly — SQLite is no longer used anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenants & users ----------------------------------------------------

model Workspace {
  id          String   @id // wsp_<ulid>
  name        String
  slug        String   @unique
  slackTeamId String?  @unique
  plan        String   @default("free") // free|pro|business|enterprise
  settings    String   @default("{}") // JSON-encoded
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   WorkspaceMember[]
  projects  Project[]
  tickets   Ticket[]
  goals     Goal[]
  reminders Reminder[]
  slackLink SlackWorkspaceLink?
}

model User {
  id        String   @id // usr_<ulid>
  email     String   @unique
  name      String
  avatarUrl String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces            WorkspaceMember[]
  projectMembers        ProjectMember[]
  reportedTickets       Ticket[]                @relation("ReportedTickets")
  ticketAssignees       TicketAssignee[]
  ticketWatchers        TicketWatcher[]
  comments              Comment[]
  activityEvents        ActivityEvent[]
  attachments           Attachment[]
  goals                 Goal[]
  reminders             Reminder[]
  notifications         Notification[]
  GoogleCalendarAccount GoogleCalendarAccount[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        String   @default("member") // admin|member|viewer|guest
  slackUserId String?
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, slackUserId])
}

// --- Projects -----------------------------------------------------------

model Project {
  id           String    @id // prj_<ulid>
  workspaceId  String
  key          String // e.g. 'FB' for ticket prefix
  name         String
  description  String?
  estimateUnit String    @default("points") // points|hours
  ticketSeq    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  columns   WorkflowColumn[]
  tickets   Ticket[]
  labels    Label[]

  @@unique([workspaceId, key])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("member") // admin|member|viewer
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model WorkflowColumn {
  id        String   @id // col_<ulid>
  projectId String
  name      String
  position  Int
  category  String // todo|in_progress|done
  wipLimit  Int? // null = unlimited
  createdAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets Ticket[] @relation("TicketStatus")

  @@unique([projectId, position])
}

// --- Tickets ------------------------------------------------------------

model Ticket {
  id              String    @id // tkt_<ulid>
  workspaceId     String
  projectId       String
  number          Int
  title           String
  description     String? // Markdown
  statusColumnId  String
  priority        String    @default("medium") // lowest|low|medium|high|urgent
  context         String    @default("professional") // personal|professional
  reporterId      String
  dueDate         DateTime?
  startDate       DateTime?
  estimate        Float?
  epicId          String?
  rank            String // fractional index for board ordering
  archivedAt      DateTime?
  version         Int       @default(1) // optimistic locking
  // Slack origin: set when the ticket was created from a channel message;
  // thread replies on that message can then move the ticket.
  slackChannelId  String?
  slackMessageTs  String?
  statusChangedAt DateTime  @default(now()) // last column move (stale-ticket scan)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusColumn   WorkflowColumn   @relation("TicketStatus", fields: [statusColumnId], references: [id])
  reporter       User             @relation("ReportedTickets", fields: [reporterId], references: [id])
  epic           Ticket?          @relation("TicketEpic", fields: [epicId], references: [id])
  children       Ticket[]         @relation("TicketEpic")
  assignees      TicketAssignee[]
  watchers       TicketWatcher[]
  labels         TicketLabel[]
  comments       Comment[]
  activityEvents ActivityEvent[]
  attachments    Attachment[]
  goals          GoalTicket[]
  reminders      Reminder[]

  @@unique([projectId, number])
  @@index([projectId, statusColumnId])
  @@index([workspaceId])
  @@index([dueDate])
  @@index([workspaceId, context])
  @@index([slackChannelId, slackMessageTs])
}

model TicketAssignee {
  ticketId String
  userId   String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
}

model TicketWatcher {
  ticketId String
  userId   String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
}

model Label {
  id        String @id // lbl_<ulid>
  projectId String
  name      String
  color     String // hex

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets TicketLabel[]

  @@unique([projectId, name])
}

model TicketLabel {
  ticketId String
  labelId  String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
}

// --- Comments & activity -----------------------------------------------

model Comment {
  id             String    @id // cmt_<ulid>
  ticketId       String
  parentId       String?
  authorId       String
  body           String
  slackMessageTs String?
  editedAt       DateTime?
  createdAt      DateTime  @default(now())

  ticket  Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  author  User      @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model ActivityEvent {
  id        String   @id
  ticketId  String
  actorId   String? // null = system
  eventType String
  payload   String // JSON-encoded
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

// --- Goals ----------------------------------------------------------------
//
// A goal is a per-user objective scoped to a cadence period: daily, weekly,
// monthly or yearly. `periodKey` is a canonical string for the period the
// goal belongs to (see src/lib/periods.ts):
//   daily   → 2026-07-08        weekly → 2026-W28
//   monthly → 2026-07           yearly → 2026
// Goals may link tickets; progress is derived from linked-ticket completion
// plus the goal's own done flag.

model Goal {
  id          String    @id // gol_<ulid>
  workspaceId String
  ownerId     String
  title       String
  notes       String?
  cadence     String // daily|weekly|monthly|yearly
  periodKey   String
  context     String    @default("professional") // personal|professional
  status      String    @default("active") // active|completed|dropped
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tickets   GoalTicket[]

  @@index([workspaceId, ownerId, cadence, periodKey])
}

model GoalTicket {
  goalId   String
  ticketId String
  addedAt  DateTime @default(now())

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([goalId, ticketId])
}

// --- Reminders & notifications ---------------------------------------------
//
// A reminder fires at `remindAt` (UTC). The scheduler (src/lib/jobs.ts) scans
// for pending reminders past their fire time, creates an in-app Notification,
// and DMs the user on Slack when the workspace is connected. Reminders are
// manually adjustable: PATCH updates remindAt; snooze pushes it forward.

model Reminder {
  id          String    @id // rem_<ulid>
  workspaceId String
  userId      String
  ticketId    String? // optional link to a ticket
  title       String
  notes       String?
  remindAt    DateTime
  recurrence  String    @default("none") // none|daily|weekly|monthly
  status      String    @default("pending") // pending|sent|done|cancelled
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([status, remindAt])
  @@index([workspaceId, userId, remindAt])
}

model Notification {
  id        String    @id // ntf_<ulid>
  userId    String
  type      String // reminder_due|ticket_due_soon|ticket_overdue|assigned|slack
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Dedupe table for due-date reminders (TechSpec §10.5): one row per
// (ticket, kind) so the scheduler never re-notifies.
model DueReminderSent {
  ticketId String
  kind     String // due_soon|overdue
  sentAt   DateTime @default(now())

  @@id([ticketId, kind])
}

// --- Slack integration ------------------------------------------------------
//
// One Slack workspace per FlowBoard workspace. The bot token is provided via
// env (single-tenant self-hosted) or stored here after OAuth (multi-tenant).

model SlackWorkspaceLink {
  id               String   @id // slk_<ulid>
  workspaceId      String   @unique
  slackTeamId      String   @unique
  slackTeamName    String?
  botToken         String? // encrypted at rest in multi-tenant deploys; env fallback
  botUserId        String?
  defaultProjectId String?
  defaultChannelId String? // fallback channel for workspace-level notifications
  installedAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// A Slack channel wired to a project (`/flowboard link KEY` inside the
// channel, or docs/SLACK_CHANNEL_SETUP.md). Messages in the channel create
// tickets; ticket notifications (due, stale, reminders) post back to it.
model SlackChannelLink {
  id             String   @id // scl_<ulid>
  workspaceId    String
  projectId      String
  slackChannelId String   @unique
  channelName    String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([workspaceId])
}

// Slack Events API retries deliveries; event_id rows make handling
// idempotent (TechSpec §9.7). Rows older than a day can be pruned.
model SlackEventDedup {
  eventId   String   @id
  createdAt DateTime @default(now())
}

// --- Google Calendar integration --------------------------------------------
//
// A user can connect multiple Google accounts; each stores an offline
// refresh token (calendar.readonly) and the set of calendars selected for
// the Schedule view. Tokens are stored server-side in the instance DB.

model GoogleCalendarAccount {
  id             String    @id // gca_<ulid>
  userId         String
  email          String
  refreshToken   String
  accessToken    String?
  tokenExpiresAt DateTime?
  // JSON array of {id, summary, color, selected}
  calendars      String    @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
}

model Attachment {
  id          String   @id
  ticketId    String
  uploaderId  String
  filename    String
  contentType String
  sizeBytes   Int
  s3Key       String
  createdAt   DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id])
}
