# Database — Postgres 16 (see TechSpec §2). For local dev, run the bundled
# `db` service (`docker compose up db -d`) and use this connection string;
# it matches docker-compose.yml's default POSTGRES_USER/PASSWORD/DB.
DATABASE_URL="postgresql://flowboard:please-change-me@localhost:5432/flowboard"

# Integration tests (`pnpm test`) create/drop a throwaway database per spec
# file against this admin connection — same Postgres server, default
# "postgres" database. Defaults to DATABASE_URL's server if unset.
TEST_DATABASE_URL="postgresql://flowboard:please-change-me@localhost:5432/postgres"

# JWT signing secret — replace in production. See TechSpec §14.
JWT_SECRET="dev-secret-change-me"

# Public base URL of this deployment — used in Slack replies and notification links.
APP_BASE_URL="http://localhost:3000"

# --- Social sign-in (optional; demo login works without it) ---
# Create OAuth apps and set the redirect URI to
#   $APP_BASE_URL/api/v1/auth/oauth/google/callback   (Google)
#   $APP_BASE_URL/api/v1/auth/oauth/github/callback   (GitHub)
# Buttons appear on the login page only for configured providers.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Restrict NEW sign-ups to these email domains (comma-separated). Existing
# users always sign in. Empty = anyone with a Google/GitHub account.
AUTH_ALLOWED_EMAIL_DOMAINS=""

# --- Slack integration (optional; the app is fully functional without it) ---
# Signing secret from your Slack app's "Basic Information" page. Required for
# the /flowboard slash command, interactivity and events endpoints.
SLACK_SIGNING_SECRET=""
# Bot token (xoxb-...) with chat:write, im:write, users:read, users:read.email.
# Enables outbound DMs (reminders, ticket moves). Leave empty to disable.
SLACK_BOT_TOKEN=""
# Dev/demo convenience: map unrecognised Slack users to the workspace admin
# instead of failing. Keep "false" in production.
SLACK_MAP_UNKNOWN_TO_ADMIN="false"

# --- Background jobs (reminders + due-date nudges) ---
# In-process scheduler; set "false" on serverless/multi-replica deploys and
# call POST /api/v1/jobs/tick from external cron instead.
ENABLE_SCHEDULER="true"
SCHEDULER_INTERVAL_MS="60000"
# Bearer secret protecting POST /api/v1/jobs/tick. Generate: openssl rand -hex 32
CRON_SECRET=""

# Demo login — LOCAL DEV ONLY. Disabled by default in production; sign-in
# there is Google/GitHub OAuth.
ALLOW_DEMO_LOGIN="true"

# Demo seed user (created by prisma/seed.ts)
SEED_USER_EMAIL="demo@flowboard.app"
SEED_USER_NAME="Demo User"
