# Database — for local dev we use SQLite. Production uses Postgres 16 (see TechSpec §2).
DATABASE_URL="file:./dev.db"

# JWT signing secret — replace in production. See TechSpec §14.
JWT_SECRET="dev-secret-change-me"

# Public base URL of this deployment — used in Slack replies and notification links.
APP_BASE_URL="http://localhost:3000"

# --- Slack integration (optional; the app is fully functional without it) ---
# Signing secret from your Slack app's "Basic Information" page. Required for
# the /flowboard slash command, interactivity and events endpoints.
SLACK_SIGNING_SECRET=""
# Bot token (xoxb-...) with chat:write, im:write, users:read, users:read.email.
# Enables outbound DMs (reminders, ticket moves). Leave empty to disable.
SLACK_BOT_TOKEN=""
# Dev/demo convenience: map unrecognised Slack users to the workspace admin
# instead of failing. Keep "false" in production.
SLACK_MAP_UNKNOWN_TO_ADMIN="false"

# --- Background jobs (reminders + due-date nudges) ---
# In-process scheduler; set "false" on serverless/multi-replica deploys and
# call POST /api/v1/jobs/tick from external cron instead.
ENABLE_SCHEDULER="true"
SCHEDULER_INTERVAL_MS="60000"
# Bearer secret protecting POST /api/v1/jobs/tick. Generate: openssl rand -hex 32
CRON_SECRET=""

# Demo seed user (created by prisma/seed.ts)
SEED_USER_EMAIL="demo@flowboard.app"
SEED_USER_NAME="Demo User"
